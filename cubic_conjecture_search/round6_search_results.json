  "theorems": [
    {
      "name": "Girth exchange bound",
      "statement": "For a good set S whose boundary is a matching, with q unmatched outside vertices, every distinct good T satisfies girth(G)<=6|S-T|+q.",
      "proof": "bridge_completion/main.tex, Lemma exchange-girth"
    },
    {
      "name": "Unbounded deletion radius",
      "statement": "For each r there exists a connected simple cubic bipartite graph with a two-defect good set S of size n/2-1 and no distinct good T with |S-T|<=r.",
      "proof": "bridge_completion/main.tex, Theorem unbounded-exchange",
      "scope": "Counterexample to a bounded-exchange strengthening; not a counterexample to the original conjecture."
    },
    {
      "name": "Single-cycle traps",
      "statement": "In the path-based sharp bridge family, a good set of size 7t+14 cannot improve through a nondecreasing sequence of single-cycle exchanges, although the optimum is 8t+13. At t=2 the exact loss barrier is 2.",
      "proof": "bridge_completion/main.tex, Theorem cycle-trap"
    }
  ],
